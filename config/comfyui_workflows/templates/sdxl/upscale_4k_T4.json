{
  "load_image": {
    "inputs": {
      "image": "",
      "custom_width": 0,
      "custom_height": 0
    },
    "class_type": "VHS_LoadImagePath",
    "_meta": {
      "title": "Load review image (selected for 4K)"
    }
  },
  "refiner_checkpoint_loader": {
    "inputs": {
      "ckpt_name": "gonzalomoXLFluxPony_v70PhotoXLDMD.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load SDXL DMD refiner (model+CLIP+VAE)"
    }
  },
  "det_pos": {
    "inputs": {
      "text": "raw photo, photographic, natural untouched skin, visible freckles, skin pores, fine film grain, soft warm light, no makeup, natural color, true to life",
      "clip": [
        "refiner_checkpoint_loader",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Detail prompt (generic, content-neutral) \u2014 refine + USDU + detailers"
    }
  },
  "det_neg": {
    "inputs": {
      "text": "blurry, out of focus, plastic skin, waxy skin, oversharpened, jpeg artifacts, deformed, extra fingers, extra limbs, watermark, text, lowres, oversmoothed, airbrushed",
      "clip": [
        "refiner_checkpoint_loader",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Detail negative (generic)"
    }
  },
  "skin_upscale_model": {
    "inputs": {
      "model_name": "4x_foolhardy_Remacri.pth"
    },
    "class_type": "UpscaleModelLoader",
    "_meta": {
      "title": "Load upscale model \u2014 4x Remacri (photoreal skin)"
    }
  },
  "upscale": {
    "inputs": {
      "image": [
        "load_image",
        0
      ],
      "model": [
        "refiner_checkpoint_loader",
        0
      ],
      "positive": [
        "det_pos",
        0
      ],
      "negative": [
        "det_neg",
        0
      ],
      "vae": [
        "refiner_checkpoint_loader",
        2
      ],
      "upscale_model": [
        "skin_upscale_model",
        0
      ],
      "upscale_by": 2.0,
      "seed": 12346,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "lcm",
      "scheduler": "karras",
      "denoise": 0.18,
      "mode_type": "Linear",
      "tile_width": 1536,
      "tile_height": 1536,
      "mask_blur": 12,
      "tile_padding": 32,
      "seam_fix_mode": "Half Tile + Intersections",
      "seam_fix_denoise": 0.3,
      "seam_fix_width": 64,
      "seam_fix_mask_blur": 8,
      "seam_fix_padding": 16,
      "force_uniform_tiles": true,
      "tiled_decode": true,
      "batch_size": 1
    },
    "class_type": "UltimateSDUpscale",
    "_meta": {
      "title": "TRUE 4K \u2014 UltimateSDUpscale (Remacri lift + tiled lcm polish, tile 1536)"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "stage3_4k_T4",
      "images": [
        "upscale",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image \u2014 stage 3 final 4K (T4)"
    }
  }
