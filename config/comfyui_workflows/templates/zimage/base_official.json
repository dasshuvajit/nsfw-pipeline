{
  "unet": {
    "inputs": {
      "unet_name": "zImageTurbo_turbo.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model — OFFICIAL Z-Image Turbo (Tongyi/Alibaba BF16). Base is WEAK at explicit NSFW (mangles nipples/genitalia) — SFW/T1-T2 use; ZPop stays the NSFW default."
    }
  },
  "modelsampling": {
    "inputs": {
      "shift": 3.0,
      "model": [
        "unet",
        0
      ]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "ModelSamplingAuraFlow (shift 3.0 — official template value, same as ZPop)"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP (Qwen3-4B — type lumina2 is the AUTHORITATIVE routing for Z-Image, NOT qwen_image despite the encoder being Qwen; the arch is Lumina2)"
    }
  },
  "vae": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE (Flux ae — Z-Image 16ch)"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "a photograph of one adult woman, soft natural light",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive (Qwen3-4B prose — PATCHED)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (PATCHED → zeroed at cfg 1)"
    }
  },
  "neg_zero": {
    "inputs": {
      "conditioning": [
        "negative_prompt",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "ConditioningZeroOut (cfg=1 → negative inert)"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "EmptySD3LatentImage (16ch — W/H PATCHED; official template uses this, NOT 4ch EmptyLatentImage)"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "modelsampling",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "neg_zero",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler — official Z-Image Turbo (res_multistep/simple/8/cfg1, seed PATCHED). res_multistep is the official Comfy-Org sampler, validated MPS-safe and >= euler/beta (2026-06-19 A/B); it is a CORE sampler, NOT the RES4LYF res_* family that crashes on MPS."
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode — Z-Image (ae 16ch)"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "stage1_base_zimage_official",
      "images": [
        "decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image — official Z-Image base"
    }
  }
}
