{
  "unet": {
    "inputs": {
      "unet_name": "zImageTurbo_turbo.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model — official Z-Image Turbo BF16 (hires variant of the default base.json)"
    }
  },
  "lora_nsfw": {
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "zit/NSFW_master_ZIT_000017532.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 1/2 — NSFW_master_ZIT"
    }
  },
  "lora_style": {
    "inputs": {
      "model": [
        "lora_nsfw",
        0
      ],
      "lora_name": "dopsd_white_zimage_turbo_comfy.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 2/2 — dopsd_white"
    }
  },
  "modelsampling": {
    "inputs": {
      "shift": 3.0,
      "model": [
        "lora_style",
        0
      ]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "ModelSamplingAuraFlow (shift 3.0 — Z-Image few-step stability)"
    }
  },
  "deepshrink": {
    "inputs": {
      "block_number": 3,
      "downscale_factor": 2.0,
      "start_percent": 0.0,
      "end_percent": 0.35,
      "downscale_after_skip": true,
      "downscale_method": "bicubic",
      "upscale_method": "bicubic",
      "model": [
        "modelsampling",
        0
      ]
    },
    "class_type": "PatchModelAddDownscale",
    "_meta": {
      "title": "Deep-Shrink (Kohya, gonzaLomo v11) — hires coherence; block 3 x2 over first 35% of steps"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP (Qwen3-4B full-precision safetensors — type lumina2)"
    }
  },
  "vae": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE (Flux ae — Z-Image 16ch)"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "a photograph of one adult woman, soft natural light",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive (Qwen3-4B prose — PATCHED)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (PATCHED → zeroed at cfg 1)"
    }
  },
  "neg_zero": {
    "inputs": {
      "conditioning": [
        "negative_prompt",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "ConditioningZeroOut (cfg=1 → negative inert)"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 1216,
      "height": 1536,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "EmptySD3LatentImage (16ch — W/H PATCHED to _HIRES_BASE_RESOLUTION ~1.9MP, deep-shrink keeps it coherent)"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "deepshrink",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "neg_zero",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler — Z-Image hires (res_multistep/simple/8/cfg1; deep-shrink model chain)"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode — Z-Image (ae 16ch)"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "stage1_base_zimage_hires",
      "images": [
        "decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image — Z-Image hires base"
    }
  }
}
