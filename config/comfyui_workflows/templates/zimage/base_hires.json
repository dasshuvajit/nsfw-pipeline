{
  "unet": {
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model \u2014 official Z-Image Turbo BF16 (hires variant of the default base.json)"
    }
  },
  "lora_style": {
    "inputs": {
      "model": [
        "lora_dpo",
        0
      ],
      "lora_name": "zit/dopsd_white_zimage_turbo_comfy.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 2/2 \u2014 dopsd_white (style @1.0; NSFW_master removed 2026-06-29)"
    }
  },
  "modelsampling": {
    "inputs": {
      "shift": 3.0,
      "model": [
        "lora_style",
        0
      ]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "ModelSamplingAuraFlow (shift 3.0 \u2014 Z-Image few-step stability)"
    }
  },
  "deepshrink": {
    "inputs": {
      "block_number": 3,
      "downscale_factor": 2.0,
      "start_percent": 0.0,
      "end_percent": 0.35,
      "downscale_after_skip": true,
      "downscale_method": "bicubic",
      "upscale_method": "bicubic",
      "model": [
        "modelsampling",
        0
      ]
    },
    "class_type": "PatchModelAddDownscale",
    "_meta": {
      "title": "Deep-Shrink (Kohya, gonzaLomo v11) \u2014 hires coherence; block 3 x2 over first 35% of steps"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP \u2014 Qwen3-4B fp16 (lumina2) [was Engineer-V6 GGUF]"
    }
  },
  "vae": {
    "inputs": {
      "vae_name": "zit/ultrafluxVAEImproved_v10.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE \u2014 ultrafluxVAEImproved_v10 [was ae.safetensors]"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "a photograph of one adult woman, soft natural light",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive (Qwen3-4B prose \u2014 PATCHED)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (PATCHED \u2192 zeroed at cfg 1)"
    }
  },
  "neg_zero": {
    "inputs": {
      "conditioning": [
        "negative_prompt",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "ConditioningZeroOut (cfg=1 \u2192 negative inert)"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 1216,
      "height": 1536,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "EmptySD3LatentImage (16ch \u2014 W/H PATCHED to _HIRES_BASE_RESOLUTION ~1.9MP, deep-shrink keeps it coherent)"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "dpmpp_sde",
      "scheduler": "beta",
      "denoise": 1,
      "model": [
        "deepshrink",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "neg_zero",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler \u2014 Z-Image hires (dpmpp_sde/beta/8/cfg1; deep-shrink model chain)"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode \u2014 Z-Image (ultrafluxVAEImproved_v10, 16ch)"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "stage1_base_zimage_hires",
      "images": [
        "decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image \u2014 Z-Image hires base"
    }
  },
  "lora_dpo": {
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "zit/zit_fdpo_v1.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 1/2 \u2014 flow-DPO (zit_fdpo_v1 @1.0, FIRST)"
    }
  }
}
