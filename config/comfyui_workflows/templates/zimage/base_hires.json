{
  "unet": {
    "inputs": {
      "unet_name": "gonzalomoZpop_v40.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model \u2014 gonzaLomo ZPop v4.0 (Z-Image Turbo BF16, NSFW)"
    }
  },
  "modelsampling": {
    "inputs": {
      "shift": 3.0,
      "model": [
        "unet",
        0
      ]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "ModelSamplingAuraFlow (shift 3.0 \u2014 Z-Image few-step stability)"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP (Qwen3-4B \u2014 type lumina2 auto-routes to Z-Image TE)"
    }
  },
  "vae": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE (Flux ae \u2014 Z-Image 16ch, already on disk)"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "a photograph of one adult woman, soft natural light",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive (Qwen3-4B prose \u2014 PATCHED)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (PATCHED \u2192 zeroed at cfg 1)"
    }
  },
  "neg_zero": {
    "inputs": {
      "conditioning": [
        "negative_prompt",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "ConditioningZeroOut (cfg=1 \u2192 negative inert, like Chroma flash)"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 1216,
      "height": 1536,
      "batch_size": 1
