    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "EmptySD3LatentImage (16ch \u2014 W/H PATCHED)"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "deepshrink",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "neg_zero",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler \u2014 Z-Image hires (res_multistep/simple/8/cfg1; deep-shrink model)"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode \u2014 Z-Image (ae 16ch)"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "stage1_base_zimage",
      "images": [
        "decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image \u2014 Z-Image base"
    }
  },
  "deepshrink": {
    "inputs": {
      "block_number": 3,
      "downscale_factor": 2.0,
      "start_percent": 0.0,
      "end_percent": 0.35,
      "downscale_after_skip": true,
      "downscale_method": "bicubic",
      "upscale_method": "bicubic",
      "model": [
        "modelsampling",
        0
      ]
    },
    "class_type": "PatchModelAddDownscale",
    "_meta": {
      "title": "Deep-Shrink (Kohya, gonzaLomo v11) \u2014 hires coherence; block 3 x2 over first 35% of steps"
    }
  }
