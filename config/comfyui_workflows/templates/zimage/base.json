    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP \u2014 Qwen3-4B fp16 (lumina2) [was Engineer-V6 GGUF]"
    }
  },
  "vae": {
    "inputs": {
      "vae_name": "zit/ultrafluxVAEImproved_v10.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE \u2014 ultrafluxVAEImproved_v10 [was ae.safetensors]"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "a photograph of one adult woman, soft natural light",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive (Qwen3-4B prose \u2014 PATCHED)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (PATCHED \u2192 zeroed at cfg 1)"
    }
  },
  "neg_zero": {
    "inputs": {
      "conditioning": [
        "negative_prompt",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "ConditioningZeroOut (cfg=1 \u2192 negative inert)"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "EmptySD3LatentImage (16ch \u2014 W/H PATCHED to render_pipeline.base_resolution ~1MP; never the source workflow's MPS-unsafe 1536x2048)"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "dpmpp_sde",
      "scheduler": "beta",
      "denoise": 1,
      "model": [
        "modelsampling",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "neg_zero",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler \u2014 Z-Image Turbo (dpmpp_sde/beta/8/cfg1, seed PATCHED; user-preferred after manual testing \u2014 slower than res_multistep but better detail)"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode \u2014 Z-Image (ultrafluxVAEImproved_v10, 16ch)"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "stage1_base_zimage",
      "images": [
        "decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image \u2014 Z-Image base (official + flow-DPO + dopsd_white)"
    }
  },
  "lora_dpo": {
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "zit/zit_fdpo_v1.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 1/3 \u2014 flow-DPO (zit_fdpo_v1 @1.0, FIRST in the stack; counters Turbo flatness)"
    }
  }
}
