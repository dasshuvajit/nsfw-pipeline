  },
  "modelsampling": {
    "inputs": {
      "shift": 3.0,
      "model": [
        "lora_style",
        0
      ]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "ModelSamplingAuraFlow (shift 3.0 \u2014 Z-Image few-step stability; re-added vs the source workflow which omitted it)"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
