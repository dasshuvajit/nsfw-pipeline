{
  "unet": {
    "inputs": {
      "unet_name": "zImageTurbo_turbo.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model — official Z-Image Turbo BF16 (NSFW via the LoRA stack below; ZPop preserved as base_zpop.json)"
    }
  },
  "lora_nsfw": {
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "zit/NSFW_master_ZIT_000017532.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 1/2 — NSFW_master_ZIT (restores explicit anatomy on the NSFW-weak official base; strength tuned by 2026-06-19 validation)"
    }
  },
  "lora_style": {
    "inputs": {
      "model": [
        "lora_nsfw",
        0
      ],
      "lora_name": "dopsd_white_zimage_turbo_comfy.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 2/2 — dopsd_white (style/realism, from the Engineer V6 workflow; stacked after NSFW_master)"
    }
  },
  "modelsampling": {
    "inputs": {
      "shift": 3.0,
      "model": [
        "lora_style",
        0
      ]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "ModelSamplingAuraFlow (shift 3.0 — Z-Image few-step stability; re-added vs the source workflow which omitted it)"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "Z-Image-Engineer-V6-Q8_0.gguf",
      "type": "lumina2",
      "device": "default"
    },
    "class_type": "ClipLoaderGGUF",
    "_meta": {
      "title": "Load CLIP — Z-Image-Engineer-V6 Q8_0 GGUF (type lumina2; user-preferred after manual testing; needs custom_nodes/ComfyUI-GGUF)"
    }
  },
  "vae": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE (Flux ae — Z-Image 16ch)"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "a photograph of one adult woman, soft natural light",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive (Qwen3-4B prose — PATCHED)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (PATCHED → zeroed at cfg 1)"
    }
  },
  "neg_zero": {
    "inputs": {
      "conditioning": [
        "negative_prompt",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "ConditioningZeroOut (cfg=1 → negative inert)"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "EmptySD3LatentImage (16ch — W/H PATCHED to render_pipeline.base_resolution ~1MP; never the source workflow's MPS-unsafe 1536x2048)"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "dpmpp_sde",
      "scheduler": "beta",
      "denoise": 1,
      "model": [
        "modelsampling",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "neg_zero",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler — Z-Image Turbo (dpmpp_sde/beta/8/cfg1, seed PATCHED; user-preferred after manual testing — slower than res_multistep but better detail)"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode — Z-Image (ae 16ch)"
    }
  },
  "save": {
    "inputs": {
      "filename_prefix": "stage1_base_zimage",
      "images": [
        "decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image — Z-Image base (official + NSFW_master + dopsd_white)"
    }
  }
}
