    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model \u2014 official Z-Image Turbo BF16 (NSFW-weak base; NSFW via the tier-gated LoRA stack below)"
    }
  },
  "lora_nsfw": {
    "inputs": {
      "model": [
        "lora_dpo",
        0
      ],
      "lora_name": "zit/NSFW_master_ZIT_000017532.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 2/3 \u2014 NSFW_master_ZIT (restores explicit anatomy on the NSFW-weak official base; TIER-GATED at render time: 0.8 at T3/T4, 0.0 at T1/T2 + covers)"
    }
  },
  "lora_style": {
    "inputs": {
      "model": [
        "lora_nsfw",
        0
      ],
      "lora_name": "zit/dopsd_white_zimage_turbo_comfy.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "LoRA 3/3 \u2014 dopsd_white (style/realism; stacked after NSFW_master @0.8)"
