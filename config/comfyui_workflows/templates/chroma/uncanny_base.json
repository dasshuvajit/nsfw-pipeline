{
  "loader": {
    "inputs": {
      "unet_name": "uncannyPhotorealism_v13.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model — UnCanny v1.3 BASE" }
  },
  "clip_loader": {
    "inputs": {
      "clip_name": "t5xxl_fp16.safetensors",
      "type": "chroma",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP (T5 chroma)" }
  },
  "t5_opts": {
    "inputs": {
      "min_padding": 1,
      "min_length": 0,
      "clip": ["clip_loader", 0]
    },
    "class_type": "T5TokenizerOptions",
    "_meta": { "title": "T5TokenizerOptions" }
  },
  "vae_loader": {
    "inputs": { "vae_name": "ae.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE (Flux ae)" }
  },
  "positive_prompt": {
    "inputs": {
      "text": "a photograph of one adult woman, soft natural light",
      "clip": ["t5_opts", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive" }
  },
  "negative_prompt": {
    "inputs": {
      "text": "low quality, deformed, blurry",
      "clip": ["t5_opts", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative (ACTIVE at cfg 3.5)" }
  },
  "empty_latent": {
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "EmptySD3LatentImage" }
  },
  "ksampler": {
    "inputs": {
      "seed": 1,
      "steps": 35,
      "cfg": 3.5,
      "sampler_name": "res_2m",
      "scheduler": "bong_tangent",
      "denoise": 1,
      "model": ["loader", 0],
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "latent_image": ["empty_latent", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler — UnCanny base (res_2m/bong_tangent/35/cfg3.5)" }
  },
  "vae_decode": {
    "inputs": { "samples": ["ksampler", 0], "vae": ["vae_loader", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "save": {
    "inputs": { "filename_prefix": "ab_uncanny_base", "images": ["vae_decode", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
