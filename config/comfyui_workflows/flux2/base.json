{
  "load_unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-9b.safetensors",
      "weight_dtype": "default"
    }
  },
  "load_clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_8b_fp8mixed.safetensors",
      "type": "flux2",
      "device": "default"
    }
  },
  "lora_loader_0": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "ultra_real_v4.safetensors",
      "strength_model": 0.7,
      "strength_clip": 0.7,
      "model": ["load_unet", 0],
      "clip": ["load_clip", 0]
    }
  },
  "lora_loader_1": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "klein_slider_anatomy.safetensors",
      "strength_model": 2.0,
      "strength_clip": 2.0,
      "model": ["lora_loader_0", 0],
      "clip": ["lora_loader_0", 1]
    }
  },
  "load_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["lora_loader_1", 1]
    }
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["lora_loader_1", 1]
    }
  },
  "empty_latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "ksampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["lora_loader_1", 0],
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "latent_image": ["empty_latent", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["ksampler", 0],
      "vae": ["load_vae", 0]
    }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "flux2",
      "images": ["vae_decode", 0]
    }
  }
}
