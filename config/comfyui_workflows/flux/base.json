{
  "load_unet": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "fluxedUpFluxNSFW_71Q8GGUF.gguf"
    }
  },
  "load_clip": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "lora_loader_0": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "PLACEHOLDER_AMATEUR_PHOTO.safetensors",
      "strength_model": 0.7,
      "strength_clip": 0.7,
      "model": ["load_unet", 0],
      "clip": ["load_clip", 0]
    }
  },
  "lora_loader_1": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "PLACEHOLDER_NSFW_UNLOCK.safetensors",
      "strength_model": 0.6,
      "strength_clip": 0.6,
      "model": ["lora_loader_0", 0],
      "clip": ["lora_loader_0", 1]
    }
  },
  "model_sampling": {
    "class_type": "ModelSamplingFlux",
    "inputs": {
      "model": ["lora_loader_1", 0],
      "max_shift": 1.15,
      "base_shift": 0.5,
      "width": 1024,
      "height": 1024
    }
  },
  "load_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["lora_loader_1", 1]
    }
  },
  "flux_guidance": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["positive_prompt", 0],
      "guidance": 3.5
    }
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["lora_loader_1", 1]
    }
  },
  "empty_latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "ksampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 28,
      "cfg": 1.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "beta",
      "denoise": 1.0,
      "model": ["model_sampling", 0],
      "positive": ["flux_guidance", 0],
      "negative": ["negative_prompt", 0],
      "latent_image": ["empty_latent", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["ksampler", 0],
      "vae": ["load_vae", 0]
    }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "flux",
      "images": ["vae_decode", 0]
    }
  }
}
