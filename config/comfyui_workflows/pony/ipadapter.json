{
  "load_checkpoint": {
    "inputs": {
      "ckpt_name": "cyberrealisticPony_v170.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint"
    }
  },
  "clip_skip": {
    "inputs": {
      "stop_at_clip_layer": -2,
      "clip": [
        "load_checkpoint",
        1
      ]
    },
    "class_type": "CLIPSetLastLayer",
    "_meta": {
      "title": "CLIP Set Last Layer (Clip Skip 2)"
    }
  },
  "load_reference_image": {
    "inputs": {
      "image": "placeholder.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Image"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 896,
      "height": 1152,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image"
    }
  },
  "lora_loader_0": {
    "inputs": {
      "lora_name": "placeholder.safetensors",
      "strength_model": 0.5,
      "strength_clip": 0.5,
      "model": [
        "load_checkpoint",
        0
      ],
      "clip": [
        "clip_skip",
        0
      ]
    },
    "class_type": "LoraLoader",
    "_meta": {
      "title": "Load LoRA (Model and CLIP)"
    }
  },
  "lora_loader_1": {
    "inputs": {
      "lora_name": "placeholder.safetensors",
      "strength_model": 0.5,
      "strength_clip": 0.5,
      "model": [
        "lora_loader_0",
        0
      ],
      "clip": [
        "lora_loader_0",
        1
      ]
    },
    "class_type": "LoraLoader",
    "_meta": {
      "title": "Load LoRA (Model and CLIP)"
    }
  },
  "ipadapter_unified_loader": {
    "inputs": {
      "preset": "PLUS (high strength)",
      "model": [
        "lora_loader_1",
        0
      ]
    },
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": {
      "title": "IPAdapter Unified Loader"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "placeholder",
      "clip": [
        "lora_loader_1",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Prompt)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "placeholder",
      "clip": [
        "lora_loader_1",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Prompt)"
    }
  },
  "ipadapter_apply": {
    "inputs": {
      "weight": 1,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0,
      "end_at": 1,
      "embeds_scaling": "V only",
      "model": [
        "ipadapter_unified_loader",
        0
      ],
      "ipadapter": [
        "ipadapter_unified_loader",
        1
      ],
      "image": [
        "load_reference_image",
        0
      ]
    },
    "class_type": "IPAdapterAdvanced",
    "_meta": {
      "title": "IPAdapter Advanced"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 5,
      "sampler_name": "dpmpp_sde",
      "scheduler": "karras",
      "denoise": 1,
      "model": [
        "ipadapter_apply",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "negative_prompt",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "vae_decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "load_checkpoint",
        2
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "save_image": {
    "inputs": {
      "filename_prefix": "pony_ipa",
      "images": [
        "vae_decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
