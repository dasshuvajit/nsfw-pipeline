{
  "load_image": {
    "inputs": {
      "image": "placeholder.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Image"
    }
  },
  "upscale_model_loader": {
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    },
    "class_type": "UpscaleModelLoader",
    "_meta": {
      "title": "Load Upscale Model"
    }
  },
  "upscale_with_model": {
    "inputs": {
      "upscale_model": [
        "upscale_model_loader",
        0
      ],
      "image": [
        "load_image",
        0
      ]
    },
    "class_type": "ImageUpscaleWithModel",
    "_meta": {
      "title": "Upscale Image (using Model)"
    }
  },
  "downscale_to_target": {
    "inputs": {
      "upscale_method": "lanczos",
      "scale_by": 0.35,
      "image": [
        "upscale_with_model",
        0
      ]
    },
    "class_type": "ImageScaleBy",
    "_meta": {
      "title": "Downscale to 1.4x of source (4x model output × 0.35)"
    }
  },
  "save_image": {
    "inputs": {
      "filename_prefix": "upscale_pony",
      "images": [
        "downscale_to_target",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
