{
  "load_checkpoint": {
    "inputs": {
      "ckpt_name": "perfectionRealisticILXL_70.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint"
    }
  },
  "lora_loader_0": {
    "inputs": {
      "lora_name": "placeholder.safetensors",
      "strength_model": 0.5,
      "strength_clip": 0.5,
      "model": [
        "load_checkpoint",
        0
      ],
      "clip": [
        "load_checkpoint",
        1
      ]
    },
    "class_type": "LoraLoader",
    "_meta": {
      "title": "Load LoRA 0"
    }
  },
  "lora_loader_1": {
    "inputs": {
      "lora_name": "placeholder.safetensors",
      "strength_model": 0.5,
      "strength_clip": 0.5,
      "model": [
        "lora_loader_0",
        0
      ],
      "clip": [
        "lora_loader_0",
        1
      ]
    },
    "class_type": "LoraLoader",
    "_meta": {
      "title": "Load LoRA 1"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image"
    }
  },
  "positive_prompt": {
    "inputs": {
      "text": "test positive",
      "clip": [
        "lora_loader_1",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Positive)"
    }
  },
  "negative_prompt": {
    "inputs": {
      "text": "test negative",
      "clip": [
        "lora_loader_1",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Negative)"
    }
  },
  "ksampler": {
    "inputs": {
      "seed": 0,
      "steps": 24,
      "cfg": 4.0,
      "sampler_name": "dpmpp_3m_sde",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "lora_loader_1",
        0
      ],
      "positive": [
        "positive_prompt",
        0
      ],
      "negative": [
        "negative_prompt",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "vae_decode": {
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "load_checkpoint",
        2
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "save_image": {
    "inputs": {
      "filename_prefix": "illustrious",
      "images": [
        "vae_decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
