# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# Generated outputs (do not commit images/sets). Catch-all: EVERYTHING under
# output/ is generated (series runs, A/B dirs, smoke renders, ad-hoc upload
# staging like DA_UPLOAD_*) — 2026-08: replaced the per-subdir enumeration,
# which let unlisted ad-hoc dirs pollute git status. Files already tracked
# under output/ (the pre-pivot T4_explicit series) stay tracked.
output/*

# Models (large binaries — fetched separately)
models/*
!models/.gitkeep
!models/README.md

# Character reference images / generated identities
characters/*
!characters/.gitkeep

# External reference images (third-party art — do not commit)
reference_images/*
!reference_images/.gitkeep

# IDE / OS
.idea/
.vscode/
.DS_Store

# Logs
*.log
logs/

# Runtime lock files
/tmp/nsfw_pipeline.lock
.claude/*.lock
