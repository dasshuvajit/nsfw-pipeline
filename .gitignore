# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# Generated outputs (do not commit images/sets)
output/soft/*
output/full/*
output/art_series/
output/wordband_ab/
output/chroma_model_ab/
output/ab_tests/
# tier-split packaged series
output/T1_suggestive/
output/T2_implied/
output/T3_artnude/
output/T4_explicit/
# smoke/scratch renders + A/B dirs (_staged_*, _v12_*, _ab_*, _gonzalomo_*)
output/_*
!output/soft/.gitkeep
!output/full/.gitkeep

# Models (large binaries — fetched separately)
models/*
!models/.gitkeep
!models/README.md

# Character reference images / generated identities
characters/*
!characters/.gitkeep

# External reference images (third-party art — do not commit)
reference_images/*
!reference_images/.gitkeep

# IDE / OS
.idea/
.vscode/
.DS_Store

# Logs
*.log
logs/

# Runtime lock files
/tmp/nsfw_pipeline.lock
.claude/*.lock
